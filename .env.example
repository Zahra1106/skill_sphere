# Copy to .env for LOCAL development
NODE_ENV=development
PORT=3000

# Firebase project ID (Firebase console -> Project settings -> General)
FIREBASE_PROJECT_ID=skillsphere-7aada

# Local: a SQLite file. On Vercel use your Turso URL instead (libsql://...)
DATABASE_URL=file:./data/skillsphere.db
# Only needed for Turso (leave empty for a local file)
DATABASE_AUTH_TOKEN=

# Only for Flutter WEB builds (comma separated). Mobile apps do not need this.
CORS_ORIGINS=

# Keep true: users must verify their email (same rule as the app).
REQUIRE_VERIFIED_EMAIL=true

# Max requests per IP per 15 minutes (per server instance)
RATE_LIMIT_MAX=600
